# --- HubSpot (required for fetch-and-score-hubspot-data) ---
HUBSPOT_ACCESS_TOKEN=       # HubSpot Private App access token (Settings -> Integrations -> Private Apps)
CLOSED_STAGE_IDS=           # Comma-separated closed deal-stage internal IDs, e.g. closedwon,closedlost
HUBSPOT_PIPELINE_ID=        # Optional: restrict to one pipeline's internal ID; leave unset for all pipelines
HUBSPOT_ACTIVITY_LOOKBACK_DAYS=30   # Optional: how many days back to fetch deals from, default 30

# --- Risk scoring thresholds (optional, tune per client) ---
RISK_HIGH_INACTIVITY_DAYS=14    # Days of no activity -> HIGH risk, default 14
RISK_MEDIUM_INACTIVITY_DAYS=7   # Days of no activity -> MEDIUM risk, default 7

# --- Schedule + formatting (optional, tune per client) ---
DIGEST_TIMEZONE=America/Sao_Paulo   # IANA timezone the Monday 8am cron runs in
DIGEST_CURRENCY=USD                 # ISO 4217 currency code: USD, BRL, CAD, EUR, GBP, etc.

# --- Brand (optional, per-client identity — only affects visual chrome, not risk colors) ---
BRAND_COMPANY_NAME=         # Shown in the report masthead, default "RevOps Intelligence"
BRAND_REPORT_TITLE=         # Report title, default "Weekly Health Digest"
BRAND_LOGO_URL=             # Optional: https URL to a logo image shown in the email header
BRAND_PRIMARY_COLOR=        # Hex, masthead background, default #0b0b0b
BRAND_ON_PRIMARY_COLOR=     # Hex, text color against the masthead background, default #ffffff (keep high contrast against BRAND_PRIMARY_COLOR)
BRAND_ACCENT_COLOR=         # Hex, section-label underline/accents, default #2a78d6

# --- Delivery (required for deliver-digest) ---
DELIVERY_METHOD=            # One of: email, slack, clickup

# Required only if DELIVERY_METHOD=email
RESEND_API_KEY=             # Resend API key (resend.com dashboard -> API Keys)
RESEND_FROM_EMAIL=          # Verified sender address in Resend, e.g. digest@yourdomain.com
DIGEST_RECIPIENT_EMAIL=     # Recipient address(es); comma-separated if multiple

# Required only if DELIVERY_METHOD=slack
SLACK_WEBHOOK_URL=          # Incoming Webhook URL for the target Slack channel

# Required only if DELIVERY_METHOD=clickup
CLICKUP_API_TOKEN=          # ClickUp Personal API Token (Settings -> Apps)
CLICKUP_LIST_ID=            # ClickUp List ID where digest task(s) are created
CLICKUP_MODE=               # One of: simple, advanced
